# Copy to .env and fill in real values before deploying. Everything here is a
# placeholder — the server intentionally still works (except /auth/*) if this
# file is missing entirely.

# Local Postgres, matching docker-compose.yml at the repo root.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/quizjumper

# Any long random string in real environments — this placeholder is fine for
# local dev only.
JWT_SECRET=dev-only-placeholder-change-me

# Google OAuth — leave as "placeholder" until a real Google Cloud OAuth
# client exists. GET /auth/google responds with a clear "not configured"
# error while these are unset/placeholder.
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Gemini API key for AI quiz generation (POST /quizzes/generate). Leave unset
# in local dev if you're not exercising that endpoint.
GEMINI_API_KEY=placeholder
# 'low' or 'medium' — see server/src/config.ts.
GEMINI_THINKING_LEVEL=low
